<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.jobsearch.jobboards</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>jobtracker</string>
    <string>run</string>
    <string>jobboards</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/JobSearch</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/path/to/JobSearch/outputs/logs/jobboards.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/JobSearch/outputs/logs/jobboards.launchd.err.log</string>
</dict>
</plist>
