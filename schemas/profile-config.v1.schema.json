{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-dmytro/jobsearch-toolchain/schemas/profile-config.v1.schema.json",
  "title": "JobSearch profile configuration v1",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "profile": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "output_slug",
        "targets_path",
        "report_path_template",
        "email_body_template",
        "email_subject_prefix",
        "profile_files"
      ],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "output_slug": { "type": "string", "minLength": 1 },
        "targets_path": { "type": "string", "minLength": 1 },
        "report_path_template": { "type": "string", "minLength": 1 },
        "email_body_template": { "type": "string", "minLength": 1 },
        "email_subject_prefix": { "type": "string", "minLength": 1 },
        "profile_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evaluation_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "email_to": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "profile"],
  "additionalProperties": false
}
