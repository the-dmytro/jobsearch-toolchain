SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<percent-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=job-artifacts
SUPABASE_SECRET_KEY=<secret-key>

# Deterministic automation helpers
# Incoming mail via iCloud IMAP. Create an Apple app-specific password at account.apple.com.
JOBTRACKER_IMAP_HOST=imap.mail.me.com
JOBTRACKER_IMAP_USER=<icloud-address>
JOBTRACKER_IMAP_PASSWORD=<apple-app-specific-password>

# Outgoing report mail via Gmail SMTP. Create a Google app password at myaccount.google.com/apppasswords.
JOBTRACKER_SMTP_HOST=smtp.gmail.com
JOBTRACKER_SMTP_PORT=465
JOBTRACKER_SMTP_USER=<gmail-address>
JOBTRACKER_SMTP_PASSWORD=<gmail-app-password>
JOBTRACKER_SMTP_FROM=<gmail-address>
JOBTRACKER_REPORT_EMAIL_TO=job@example.com

# CRM (Next.js in crm/) — browser uses anon key + RLS; server actions may use service role for Storage
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Comma-separated allowlist (must match Supabase Auth user emails)
CRM_OWNER_EMAIL=job@example.com
# Optional locally; on Vercel the CRM infers origin from VERCEL_* env vars
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to true to show demo-mode UI banner (use with db/seeds/demo.sql)
NEXT_PUBLIC_DEMO_MODE=false
