# Standard local SQLite setup needs no environment variables.

# Optional PostgreSQL or hosted Supabase
# [store] transport = "direct":
JOBTRACKER_DATABASE_URL=postgresql://user:password@host.example.invalid:5432/database
# [store] transport = "supabase_https" uses SUPABASE_URL and SUPABASE_SECRET_KEY below.
# When a proxy injects the key as a network secret, set SUPABASE_SECRET_KEY=proxy-injected.
SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/jobtracker_test
SUPABASE_URL=https://project.example.invalid
SUPABASE_SECRET_KEY=<server-secret>
SUPABASE_STORAGE_BUCKET=job-artifacts

# Optional IMAP inbox
JOBTRACKER_IMAP_HOST=imap.example.com
JOBTRACKER_IMAP_USER=person@example.com
JOBTRACKER_IMAP_PASSWORD=<app-password>

# Optional SMTP sender
JOBTRACKER_SMTP_HOST=smtp.example.com
JOBTRACKER_SMTP_PORT=465
JOBTRACKER_SMTP_USER=person@example.com
JOBTRACKER_SMTP_PASSWORD=<app-password>
JOBTRACKER_SMTP_FROM=reports@example.com
JOBTRACKER_REPORT_EMAIL_TO=person@example.com

# Optional CRM with hosted Supabase
NEXT_PUBLIC_SUPABASE_URL=https://project.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
CRM_OWNER_EMAIL=person@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
